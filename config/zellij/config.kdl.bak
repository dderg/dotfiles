// Zellij config - tmux-like keybindings with Ctrl-a prefix
// Mirrors tmux.conf behavior as closely as possible

keybinds clear-defaults=true {
    // Normal mode: keys pass through to the terminal
    // Only pane navigation and prefix key are active
    normal {
        // Vim-style pane navigation (like vim-tmux-navigator)
        bind "Ctrl h" { MoveFocus "Left"; }
        bind "Ctrl j" { MoveFocus "Down"; }
        bind "Ctrl k" { MoveFocus "Up"; }
        bind "Ctrl l" { MoveFocus "Right"; }
    }

    // Tmux-like prefix mode (Ctrl-a then key)
    tmux {
        // Send literal Ctrl-a to terminal (Ctrl-a Ctrl-a or Ctrl-a a)
        bind "Ctrl a" { Write 1; SwitchToMode "Normal"; }
        bind "a" { Write 1; SwitchToMode "Normal"; }

        // Splits (matching tmux bindings, preserving CWD)
        bind "%" { NewPane "Right"; SwitchToMode "Normal"; }
        bind "\"" { NewPane "Down"; SwitchToMode "Normal"; }

        // New tab (like tmux: prefix N -> new-window)
        bind "N" { NewTab; SwitchToMode "Normal"; }

        // Tab navigation (like tmux: prefix Ctrl-h/Ctrl-l)
        bind "Ctrl h" { GoToPreviousTab; SwitchToMode "Normal"; }
        bind "Ctrl l" { GoToNextTab; SwitchToMode "Normal"; }

        // Resize panes (like tmux: prefix H/J/K/L)
        bind "H" { Resize "Increase Left"; }
        bind "J" { Resize "Increase Down"; }
        bind "K" { Resize "Increase Up"; }
        bind "L" { Resize "Increase Right"; }

        // Lazygit in floating pane (like tmux: prefix g -> popup lazygit)
        bind "g" {
            Run "lazygit" {
                floating true
                close_on_exit true
            };
            SwitchToMode "Normal";
        }

        // Yazi in floating pane (like tmux: prefix y -> new-window yazi)
        bind "y" {
            Run "yazi" {
                floating true
                close_on_exit true
            };
            SwitchToMode "Normal";
        }

        // Yazi in a right split (like tmux: prefix Y -> split-window -h yazi)
        bind "Y" {
            Run "yazi" {
                direction "Right"
                close_on_exit true
            };
            SwitchToMode "Normal";
        }

        // Session manager (like tmux: prefix s -> fzf session switcher)
        bind "s" {
            LaunchOrFocusPlugin "session-manager" {
                floating true
                move_to_focused_tab true
            };
            SwitchToMode "Normal";
        }

        // Copy/scroll mode (like tmux: prefix Escape or prefix [)
        bind "Esc" { SwitchToMode "Scroll"; }
        bind "[" { SwitchToMode "Scroll"; }

        // Tile layout (like tmux: prefix = -> select-layout tiled)
        bind "=" { NextSwapLayout; SwitchToMode "Normal"; }

        // Zoom/fullscreen pane (like tmux zoom)
        bind "z" { ToggleFocusFullscreen; SwitchToMode "Normal"; }

        // Close pane (like tmux: prefix x)
        bind "x" { CloseFocus; SwitchToMode "Normal"; }

        // Detach (like tmux: prefix d)
        bind "d" { Detach; }

        // Rename tab (like tmux: prefix ,)
        bind "," { SwitchToMode "RenameTab"; TabNameInput 0; }

        // Go to tab by number (like tmux: prefix 1-9)
        bind "1" { GoToTab 1; SwitchToMode "Normal"; }
        bind "2" { GoToTab 2; SwitchToMode "Normal"; }
        bind "3" { GoToTab 3; SwitchToMode "Normal"; }
        bind "4" { GoToTab 4; SwitchToMode "Normal"; }
        bind "5" { GoToTab 5; SwitchToMode "Normal"; }
        bind "6" { GoToTab 6; SwitchToMode "Normal"; }
        bind "7" { GoToTab 7; SwitchToMode "Normal"; }
        bind "8" { GoToTab 8; SwitchToMode "Normal"; }
        bind "9" { GoToTab 9; SwitchToMode "Normal"; }

        // Toggle floating panes
        bind "w" { ToggleFloatingPanes; SwitchToMode "Normal"; }

        // Next layout
        bind "Space" { NextSwapLayout; SwitchToMode "Normal"; }

        // Cancel - go back to normal
        bind "Enter" { SwitchToMode "Normal"; }
    }

    // Scroll/copy mode with vi keys (like tmux copy-mode-vi)
    scroll {
        bind "Esc" "q" { ScrollToBottom; SwitchToMode "Normal"; }
        bind "j" "Down" { ScrollDown; }
        bind "k" "Up" { ScrollUp; }
        bind "Ctrl f" "PageDown" { PageScrollDown; }
        bind "Ctrl b" "PageUp" { PageScrollUp; }
        bind "d" { HalfPageScrollDown; }
        bind "u" { HalfPageScrollUp; }
        bind "G" { ScrollToBottom; }
        bind "e" { EditScrollback; SwitchToMode "Normal"; }
        bind "/" "s" { SwitchToMode "EnterSearch"; SearchInput 0; }
    }

    search {
        bind "Esc" { SwitchToMode "Normal"; }
        bind "j" "Down" { ScrollDown; }
        bind "k" "Up" { ScrollUp; }
        bind "Ctrl f" "PageDown" { PageScrollDown; }
        bind "Ctrl b" "PageUp" { PageScrollUp; }
        bind "d" { HalfPageScrollDown; }
        bind "u" { HalfPageScrollUp; }
        bind "n" { Search "down"; }
        bind "N" { Search "up"; }
        bind "c" { SearchToggleOption "CaseSensitivity"; }
        bind "w" { SearchToggleOption "Wrap"; }
        bind "o" { SearchToggleOption "WholeWord"; }
    }

    entersearch {
        bind "Ctrl c" "Esc" { SwitchToMode "Scroll"; }
        bind "Enter" { SwitchToMode "Search"; }
    }

    renametab {
        bind "Enter" { SwitchToMode "Normal"; }
        bind "Ctrl c" { SwitchToMode "Normal"; }
        bind "Esc" { UndoRenameTab; SwitchToMode "Normal"; }
    }

    renamepane {
        bind "Enter" { SwitchToMode "Normal"; }
        bind "Ctrl c" { SwitchToMode "Normal"; }
        bind "Esc" { UndoRenamePane; SwitchToMode "Normal"; }
    }

    // Locked mode - all keys pass through (like tmux passthrough)
    locked {
        bind "Ctrl g" { SwitchToMode "Normal"; }
    }

    // Ctrl-a enters tmux/prefix mode from everywhere except locked
    shared_except "locked" "tmux" {
        bind "Ctrl a" { SwitchToMode "Tmux"; }
    }
    // Ctrl-g enters locked mode from everywhere except locked
    shared_except "locked" {
        bind "Ctrl g" { SwitchToMode "Locked"; }
    }
}

// Catppuccin Mocha theme (matching tmux theme colors)
themes {
    catppuccin-mocha {
        fg "#cdd6f4"
        bg "#1e1e2e"
        black "#181825"
        red "#f38ba8"
        green "#a6e3a1"
        yellow "#f9e2af"
        blue "#89b4fa"
        magenta "#cba6f7"
        orange "#fab387"
        cyan "#89dceb"
        white "#cdd6f4"
    }
}

theme "catppuccin-mocha"

// Status bar on top (like tmux status-position top)
// Using compact layout which places tab bar at top
default_layout "compact"

// Mouse support (like tmux: setw -g mouse on)
mouse_mode true

// Scrollback buffer (like tmux: history-limit 20000)
scroll_buffer_size 20000

// Copy to clipboard on select (like tmux vi copy mode + pbcopy)
copy_on_select true
copy_command "pbcopy"

// No pane frames for a cleaner look
pane_frames false

// Simplified UI without arrow fonts (we use nerd fonts though, so keep it off)
// simplified_ui false

// Session serialization for resurrection (like tmux-resurrect)
session_serialization true
