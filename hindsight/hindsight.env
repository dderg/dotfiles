# Chain: LM Studio (free local, when laptop server is up) -> opencode-go (deepseek)
# -> freellmapi (auto) -> codex. The multi_llm overlay's circuit breaker puts a
# down member in cooldown (30s..300s), so a stopped LM Studio costs one probe
# per window, not 7s per request.
HINDSIGHT_API_LLM_PROVIDER=lmstudio
HINDSIGHT_API_LLM_BASE_URL=http://192.168.1.86:1234/v1
HINDSIGHT_API_LLM_MODEL=qwen/qwen3.6-35b-a3b
HINDSIGHT_API_LLM_EXTRA_BODY={"chat_template_kwargs":{"enable_thinking":false}}
HINDSIGHT_API_LLM_STRATEGY={"mode":"failover"}

HINDSIGHT_API_LLM_1_PROVIDER=opencode-go
# _1_API_KEY lives in ~/.config/hindsight/secrets.env
# Disable deepseek reasoning so output budget isn't burned on thinking tokens
HINDSIGHT_API_LLM_1_EXTRA_BODY={"thinking":{"type":"disabled"}}

HINDSIGHT_API_LLM_2_PROVIDER=openai
HINDSIGHT_API_LLM_2_BASE_URL=http://freellmapi.home/v1
HINDSIGHT_API_LLM_2_MODEL=auto
# api key in ~/.config/hindsight/secrets.env.
HINDSIGHT_API_LLM_2_EXTRA_BODY={"thinking":{"type":"disabled"},"chat_template_kwargs":{"enable_thinking":false},"reasoning_effort":"low"}

HINDSIGHT_API_LLM_3_PROVIDER=openai-codex
HINDSIGHT_API_LLM_3_MODEL=gpt-5.4-mini

# opencode-go (deepseek) only supports json_object; strict json_schema 400s ("Upstream request failed")
HINDSIGHT_API_LLM_STRICT_SCHEMA=false
HINDSIGHT_API_LLM_MAX_CONCURRENT=6
HINDSIGHT_API_LLM_TIMEOUT=600
# Wall clock for a whole reflect operation (agent loop incl. tool calls); default 300
HINDSIGHT_API_REFLECT_WALL_TIMEOUT=900

# ── Per-operation provider chains (unused, for later) ─────────────────────────
# Each op (RETAIN / REFLECT / CONSOLIDATION) can override the global chain with
# its own primary + indexed fallbacks + strategy. If set, it fully replaces the
# global HINDSIGHT_API_LLM_* chain for that op; unset ops fall back to global.
#
# Example: retain via opencode-go, failing over to freellmapi:
#HINDSIGHT_API_RETAIN_LLM_PROVIDER=opencode-go
#HINDSIGHT_API_RETAIN_LLM_API_KEY=...
#HINDSIGHT_API_RETAIN_LLM_1_PROVIDER=openai
#HINDSIGHT_API_RETAIN_LLM_1_BASE_URL=http://freellmapi.home/v1
#HINDSIGHT_API_RETAIN_LLM_1_MODEL=auto
#HINDSIGHT_API_RETAIN_LLM_1_API_KEY=...
#HINDSIGHT_API_RETAIN_LLM_STRATEGY={"mode":"failover"}
#
# Example: reflect via codex, failing over to opencode-go:
#HINDSIGHT_API_REFLECT_LLM_PROVIDER=openai-codex
#HINDSIGHT_API_REFLECT_LLM_MODEL=gpt-5.4-mini
#HINDSIGHT_API_REFLECT_LLM_1_PROVIDER=opencode-go
#HINDSIGHT_API_REFLECT_LLM_1_API_KEY=...
#HINDSIGHT_API_REFLECT_LLM_STRATEGY={"mode":"failover"}
#
# Other per-op knobs: _MODEL, _BASE_URL, _TIMEOUT, _MAX_CONCURRENT, _MAX_RETRIES.
# Per-op strict schema (e.g. reflect strict while retain stays soft for deepseek):
#HINDSIGHT_API_LLM_STRICT_SCHEMA_RETAIN=false
#HINDSIGHT_API_LLM_STRICT_SCHEMA_REFLECT=true
#HINDSIGHT_API_LLM_STRICT_SCHEMA_CONSOLIDATION=false
