# Public file. Keys and private endpoints go in ~/.config/hindsight/secrets.env,
# which is sourced after this one.

HINDSIGHT_API_LLM_STRATEGY={"mode":"failover"}

HINDSIGHT_API_LLM_PROVIDER=openai
HINDSIGHT_API_LLM_MODEL=unsloth/gpt-oss-20b-GGUF
HINDSIGHT_API_LLM_EXTRA_BODY={"chat_template_kwargs":{"enable_thinking":false}}

HINDSIGHT_API_LLM_1_PROVIDER=lmstudio
HINDSIGHT_API_LLM_1_MODEL=qwen/qwen3.6-35b-a3b
HINDSIGHT_API_LLM_1_EXTRA_BODY={"chat_template_kwargs":{"enable_thinking":false}}

HINDSIGHT_API_LLM_2_PROVIDER=openai
HINDSIGHT_API_LLM_2_MODEL=auto
HINDSIGHT_API_LLM_2_EXTRA_BODY={"thinking":{"type":"disabled"},"chat_template_kwargs":{"enable_thinking":false},"reasoning_effort":"low"}

HINDSIGHT_API_LLM_3_PROVIDER=opencode-go
HINDSIGHT_API_LLM_3_EXTRA_BODY={"thinking":{"type":"disabled"}}

HINDSIGHT_API_LLM_4_PROVIDER=openai-codex
HINDSIGHT_API_LLM_4_MODEL=gpt-5.6-luna

# opencode-go only supports json_object; strict json_schema 400s
HINDSIGHT_API_LLM_STRICT_SCHEMA=false
HINDSIGHT_API_LLM_MAX_CONCURRENT=6
HINDSIGHT_API_LLM_TIMEOUT=600
HINDSIGHT_API_REFLECT_WALL_TIMEOUT=900

HINDSIGHT_API_RERANKER_PROVIDER=local
# Same scores, less padding: 2.6s -> 2.0s per 300-pair query
HINDSIGHT_API_RERANKER_LOCAL_BUCKET_BATCHING=true
# Upstream disables MPS: its per-shape cache leaks to ~20 GB
HINDSIGHT_API_EMBEDDINGS_LOCAL_ALLOW_MPS=false

OMP_WAIT_POLICY=passive
