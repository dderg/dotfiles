#!/usr/bin/env bash
# Description: Install and manage kmonad keyboard remapper

set -Eeuo pipefail

# source helpers
source "$DOTFILES/bin/lib/common.sh"
command_name=$(basename "${BASH_SOURCE[0]}")

KMONAD_BIN="$HOME/.local/bin/kmonad"
KMONAD_CONFIG="$HOME/.config/kmonad/kmonad.kbd"
PLIST_NAME="com.kmonad.daemon"
PLIST_PATH="/Library/LaunchDaemons/${PLIST_NAME}.plist"

usage() {
  cat <<EOF
  $(fmt_key "Usage:") $(fmt_cmd "$command_name") $(fmt_value "<command>")

  Install and manage kmonad keyboard remapper.

$(fmt_key "Commands:")
    install       Build and install kmonad from source (requires stack)
    setup         Install Karabiner DEXT and create launchd daemon
    start         Start the kmonad daemon
    stop          Stop the kmonad daemon
    restart       Restart the kmonad daemon
    status        Show daemon status
    uninstall     Remove launchd daemon
EOF
}

cmd_install() {
  fmt_title_underline "Installing kmonad"

  if [[ -f "$KMONAD_BIN" ]]; then
    local version
    version=$("$KMONAD_BIN" --version 2>/dev/null | head -1 || echo "unknown")
    log_warning "kmonad already installed at $KMONAD_BIN ($version)"
    log_info "To reinstall, remove it first: rm $KMONAD_BIN"
    return 0
  fi

  # Check for stack
  if ! command -v stack &>/dev/null; then
    log_info "Installing Haskell Stack..."
    curl -sSL https://get.haskellstack.org/ | sh
  fi

  local tmpdir
  tmpdir=$(mktemp -d)

  log_info "Cloning kmonad..."
  git clone --recursive --depth 1 https://github.com/kmonad/kmonad.git "$tmpdir/kmonad"

  log_info "Building kmonad (this will take a while)..."
  mkdir -p "$(dirname "$KMONAD_BIN")"
  (
    cd "$tmpdir/kmonad"
    stack build --flag kmonad:dext
    stack install --flag kmonad:dext --local-bin-path "$(dirname "$KMONAD_BIN")"
  )

  rm -rf "$tmpdir"

  if [[ -f "$KMONAD_BIN" ]]; then
    log_success "kmonad installed successfully"
    "$KMONAD_BIN" --version
  else
    log_error "Installation failed"
    exit 1
  fi
}

install_dext() {
  log_info "Downloading Karabiner DriverKit VirtualHIDDevice..."

  # Get latest .pkg URL from GitHub API
  local pkg_url
  pkg_url=$(curl -fsSL "https://api.github.com/repos/pqrs-org/Karabiner-DriverKit-VirtualHIDDevice/releases/latest" \
    | grep -o '"browser_download_url": *"[^"]*\.pkg"' \
    | head -1 \
    | sed 's/"browser_download_url": *"//;s/"$//')

  if [[ -z "$pkg_url" ]]; then
    log_error "Could not find .pkg download URL from GitHub releases."
    log_info "Install manually from: https://github.com/pqrs-org/Karabiner-DriverKit-VirtualHIDDevice/releases"
    exit 1
  fi

  local tmpdir
  tmpdir=$(mktemp -d)
  local pkg_path="$tmpdir/Karabiner-DriverKit-VirtualHIDDevice.pkg"

  log_info "Downloading $pkg_url"
  curl -fSL -o "$pkg_path" "$pkg_url"

  log_info "Installing package (requires sudo)..."
  sudo installer -pkg "$pkg_path" -target /

  rm -rf "$tmpdir"

  log_success "Karabiner DriverKit VirtualHIDDevice installed"
}

cmd_setup() {
  fmt_title_underline "Setting up kmonad"

  if [[ ! -f "$KMONAD_BIN" ]]; then
    log_error "kmonad not found at $KMONAD_BIN. Run '$command_name install' first."
    exit 1
  fi

  if [[ ! -f "$KMONAD_CONFIG" ]]; then
    log_error "Config not found at $KMONAD_CONFIG. Run 'dot link kmonad' first."
    exit 1
  fi

  # Check for Karabiner DEXT
  local dext_path="/Library/Application Support/org.pqrs/Karabiner-DriverKit-VirtualHIDDevice"
  if [[ ! -d "$dext_path" ]]; then
    install_dext
  fi

  # Activate DEXT if not already active
  if ! systemextensionsctl list 2>/dev/null | grep -q "org.pqrs.*activated"; then
    local manager_app="/Applications/.Karabiner-VirtualHIDDevice-Manager.app/Contents/MacOS/Karabiner-VirtualHIDDevice-Manager"
    if [[ -x "$manager_app" ]]; then
      log_info "Activating Karabiner DEXT..."
      "$manager_app" activate
      log_warning "macOS may require manual approval for system extensions."
      log_info "If prompted, go to: System Settings > General > Login Items & Extensions > Driver Extensions"
      log_info "Enable 'Karabiner Virtual HID Device', then re-run: $command_name setup"
      exit 0
    else
      log_error "Manager app not found at $manager_app"
      log_info "Try reinstalling: $command_name uninstall && $command_name setup"
      exit 1
    fi
  fi

  log_success "Karabiner DEXT is installed and activated"

  # Create launchd plist
  if [[ -f "$PLIST_PATH" ]]; then
    log_warning "Launchd plist already exists at $PLIST_PATH"
    log_info "To recreate, run '$command_name uninstall' first."
    return 0
  fi

  log_info "Creating launchd daemon plist..."

  sudo tee "$PLIST_PATH" > /dev/null <<PLIST
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>${PLIST_NAME}</string>
    <key>ProgramArguments</key>
    <array>
        <string>${KMONAD_BIN}</string>
        <string>${KMONAD_CONFIG}</string>
    </array>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <key>StandardOutPath</key>
    <string>/tmp/kmonad.stdout.log</string>
    <key>StandardErrorPath</key>
    <string>/tmp/kmonad.stderr.log</string>
</dict>
</plist>
PLIST

  sudo chmod 644 "$PLIST_PATH"
  sudo chown root:wheel "$PLIST_PATH"

  log_success "Launchd daemon created at $PLIST_PATH"
  log_info "Grant Input Monitoring permission to kmonad:"
  log_info "  System Settings > Privacy & Security > Input Monitoring"
  log_info "  Add: $KMONAD_BIN"
  log_info "Then run '$command_name start'"
}

cmd_start() {
  if [[ ! -f "$PLIST_PATH" ]]; then
    log_error "Daemon not set up. Run '$command_name setup' first."
    exit 1
  fi

  log_info "Starting kmonad daemon..."
  sudo launchctl bootstrap system "$PLIST_PATH"
  log_success "kmonad daemon started"
}

cmd_stop() {
  if [[ ! -f "$PLIST_PATH" ]]; then
    log_error "Daemon not set up."
    exit 1
  fi

  log_info "Stopping kmonad daemon..."
  sudo launchctl bootout "system/$PLIST_NAME" 2>/dev/null || true
  log_success "kmonad daemon stopped"
}

cmd_status() {
  if [[ ! -f "$PLIST_PATH" ]]; then
    log_warning "Daemon not set up"
    return 1
  fi

  if sudo launchctl print "system/$PLIST_NAME" &>/dev/null; then
    log_success "kmonad daemon is running"
    sudo launchctl print "system/$PLIST_NAME"
  else
    log_info "kmonad daemon is not running"
  fi

  if [[ -f "$KMONAD_BIN" ]]; then
    log_info "Binary: $KMONAD_BIN ($("$KMONAD_BIN" --version 2>/dev/null | head -1))"
  else
    log_warning "Binary not found at $KMONAD_BIN"
  fi
}

cmd_uninstall() {
  if [[ -f "$PLIST_PATH" ]]; then
    cmd_stop
    log_info "Removing launchd plist..."
    sudo rm "$PLIST_PATH"
    log_success "Daemon removed"
  else
    log_info "No daemon plist found"
  fi
}

main() {
  if [[ $# -lt 1 ]]; then
    usage
    exit 0
  fi

  local subcmd="$1"
  shift

  case "$subcmd" in
    install)    cmd_install "$@" ;;
    setup)      cmd_setup "$@" ;;
    start)      cmd_start ;;
    stop)       cmd_stop ;;
    restart)    cmd_stop; cmd_start ;;
    status)     cmd_status ;;
    uninstall)  cmd_uninstall ;;
    -h|--help)  usage ;;
    *)
      log_error "Unknown command: $subcmd"
      usage
      exit 1
      ;;
  esac
}

main "$@"
