#!/usr/bin/env bash
# Description: Manage rift window manager service

set -Eeuo pipefail

# source helpers
source "$DOTFILES/bin/lib/common.sh"
command_name=$(basename "${BASH_SOURCE[0]}")

usage() {
  cat <<EOF
  $(fmt_key "Usage:") $(fmt_cmd "$command_name") $(fmt_value "<command>")

  Manage the rift window manager launchd service.

$(fmt_key "Commands:")
    install       Install the per-user launchd service
    start         Start the rift service
    stop          Stop the rift service
    restart       Restart the rift service
    uninstall     Remove the launchd service
    status        Show whether rift is running
EOF
}

require_rift() {
  if ! command -v rift &>/dev/null; then
    log_error "rift not found. Install rift first (brew install acsandmann/tap/rift)."
    exit 1
  fi
}

cmd_install() {
  fmt_title_underline "Installing rift service"
  require_rift
  rift service install
  log_success "rift service installed"
  log_info "Run '$command_name start' to start rift"
}

cmd_start() {
  require_rift
  log_info "Starting rift service..."
  rift service start
  log_success "rift service started"
}

cmd_stop() {
  require_rift
  log_info "Stopping rift service..."
  rift service stop
  log_success "rift service stopped"
}

cmd_restart() {
  require_rift
  log_info "Restarting rift service..."
  rift service restart
  log_success "rift service restarted"
}

cmd_uninstall() {
  require_rift
  log_info "Uninstalling rift service..."
  rift service stop 2>/dev/null || true
  rift service uninstall
  log_success "rift service uninstalled"
}

cmd_status() {
  require_rift
  if pgrep -x rift &>/dev/null; then
    log_success "rift is running (pid $(pgrep -x rift))"
  else
    log_info "rift is not running"
  fi
}

main() {
  if [[ $# -lt 1 ]]; then
    usage
    exit 0
  fi

  local subcmd="$1"
  shift

  case "$subcmd" in
    install)    cmd_install ;;
    start)      cmd_start ;;
    stop)       cmd_stop ;;
    restart)    cmd_restart ;;
    uninstall)  cmd_uninstall ;;
    status)     cmd_status ;;
    -h|--help)  usage ;;
    *)
      log_error "Unknown command: $subcmd"
      usage
      exit 1
      ;;
  esac
}

main "$@"
